generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Activity {
  id              String   @id @default(cuid())
  provider        String
  externalId      String
  title           String
  description     String
  shortDescription String?
  location        String
  region          String   @default("Scotland")
  activityType    String
  priceFrom       Float
  currency        String   @default("GBP")
  durationMinutes Int?
  rating          Float?
  reviewCount     Int      @default(0)
  imageUrl        String
  affiliateUrl    String
  tags            String   @default("[]")
  rawJson         String?
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creatives Creative[]

  @@unique([provider, externalId])
  @@index([location])
  @@index([activityType])
  @@index([priceFrom])
  @@index([rating])
  @@index([region])
}

model Creative {
  id           String   @id @default(cuid())
  slug         String   @unique
  activityId   String
  headline     String
  subheadline  String?
  ctaLabel     String   @default("GET OUTSIDE")
  locationLine String?
  priceLine    String?
  imageUrl     String
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activity    Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  events      Event[]
  socialPosts SocialPost[]

  @@index([activityId])
  @@index([status])
}

model SocialPost {
  id         String   @id @default(cuid())
  creativeId String
  platform   String
  format     String
  caption    String
  hashtags   String   @default("")
  ctaLabel   String
  ctaUrl     String
  imageUrl   String
  status     String   @default("ready")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creative Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId])
  @@index([platform])
  @@unique([creativeId, platform, format])
}

model Event {
  id         String   @id @default(cuid())
  type       String
  creativeId String?
  activityId String?
  meta       String?
  createdAt  DateTime @default(now())

  creative Creative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([creativeId])
  @@index([activityId])
  @@index([createdAt])
}

model NewsItem {
  id          String   @id @default(cuid())
  source      String
  externalId  String
  title       String
  summary     String   @default("")
  url         String
  imageUrl    String?
  publishedAt DateTime
  tags        String   @default("[]")
  region      String   @default("Scotland")
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status])
  @@index([publishedAt])
  @@index([source])
}

model NewsFeedCache {
  id           String   @id @default(cuid())
  feedUrl      String   @unique
  source       String
  etag         String?
  lastModified String?
  fetchedAt    DateTime?
  expiresAt    DateTime?
  lastStatus   String   @default("never")
  rawHash      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([source])
  @@index([expiresAt])
}
