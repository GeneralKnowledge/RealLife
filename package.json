{
  "name": "get-outside",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "llm:setup": "bash scripts/setup-freellmapi.sh",
    "llm:up": "bash -c 'test -f freellmapi/.env || exec bash scripts/setup-freellmapi.sh; docker compose --profile llm up -d freellmapi'",
    "llm:down": "docker compose --profile llm stop freellmapi",
    "llm:logs": "docker compose --profile llm logs -f freellmapi",
    "llm:smoke": "node scripts/smoke-content-ai.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.127",
    "jszip": "^3.10.2",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "posthog-js": "^1.435.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.3",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
