# App
DATABASE_URL="file:./dev.db"
# Production (Neon/Supabase): postgresql://user:pass@host/db?sslmode=require
# When using Postgres, also set prisma schema datasource provider to "postgresql".
ACTIVITY_PROVIDER="mock"
ADMIN_TOKEN="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Viator Partner API (optional — used when ACTIVITY_PROVIDER=viator)
VIATOR_API_KEY=""
VIATOR_API_BASE_URL="https://api.viator.com/partner"
VIATOR_AFFILIATE_ID=""
# Scotland destination id in Viator taxonomy (verify in /destinations)
VIATOR_DESTINATION_ID="22"

# Optional analytics / ads pixels
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_META_PIXEL_ID=""

# Content AI (OpenAI-compatible Chat Completions API)
# Recommended for local testing: FreeLLMAPI (aggregates free-tier providers).
#   pnpm llm:setup
# When BASE_URL is set, creatives + social packs use the model (templates remain the fallback).
CONTENT_AI_BASE_URL="http://127.0.0.1:3001/v1"
CONTENT_AI_API_KEY=""
CONTENT_AI_MODEL="auto:cheap"
# Many free-tier models lack native JSON schema — keep false for FreeLLMAPI.
CONTENT_AI_STRUCTURED_OUTPUTS=false
# CONTENT_AI_ENABLED=true
# Other backends:
#   OpenAI:     CONTENT_AI_BASE_URL="https://api.openai.com/v1" CONTENT_AI_MODEL="gpt-4o-mini" CONTENT_AI_STRUCTURED_OUTPUTS=true
#   Ollama:     CONTENT_AI_BASE_URL="http://127.0.0.1:11434/v1" CONTENT_AI_MODEL="llama3.2"
#   OpenRouter: CONTENT_AI_BASE_URL="https://openrouter.ai/api/v1" CONTENT_AI_API_KEY=...
