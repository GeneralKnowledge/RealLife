# App
DATABASE_URL="file:./dev.db"
# Production (Neon/Supabase): postgresql://user:pass@host/db?sslmode=require
# When using Postgres, also set prisma schema datasource provider to "postgresql".
ACTIVITY_PROVIDER="mock"
ADMIN_TOKEN="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Viator Partner API (optional — used when ACTIVITY_PROVIDER=viator)
VIATOR_API_KEY=""
VIATOR_API_BASE_URL="https://api.viator.com/partner"
VIATOR_AFFILIATE_ID=""
# Scotland destination id in Viator taxonomy (verify in /destinations)
VIATOR_DESTINATION_ID="22"

# Optional analytics / ads pixels
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_META_PIXEL_ID=""
